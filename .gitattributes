# Gestione automatica fine riga
* text=auto

# Forza l'uso di LF (Linux style) per gli script e i file di configurazione di Unity
# Questo evita conflitti inutili tra diversi sistemi operativi
*.cs text eol=lf
*.unity text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.controller text eol=lf merge=unityyamlmerge
*.csproj text eol=lf
*.sln text eol=lf

# Tratta i file binari come tali (non cercare di cambiare i ritorni a capo)
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.zip binary
# I file YAML di Unity vengono fusi da UnityYAMLMerge, che ragiona per
# oggetti invece che per righe. Ogni sviluppatore deve registrare il driver
# una volta sola in locale (vedi README): senza, git usa il merge testuale.
